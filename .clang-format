# Close to the existing style of src/: 2-space indent, " public:", "Type* name", "if(".
# Applied to src/, tests/ and lib/MeshProtocol (lib/MeshCore and lib/CayenneLPP are vendored and left as is).
# Keep it applied: clang-format -i FILE, or format-on-save.
# ColumnLimit 0 keeps the line breaks that are already there; clang-format still adds spaces around operators.
BasedOnStyle: LLVM
Language: Cpp
Standard: c++17
IndentWidth: 2
ContinuationIndentWidth: 2
AccessModifierOffset: -1
ColumnLimit: 0
PointerAlignment: Left
DerivePointerAlignment: false
SpaceBeforeParens: Never
AllowShortBlocksOnASingleLine: Always
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: true
IndentPPDirectives: None
SortIncludes: Never
ReflowComments: false
FixNamespaceComments: false
AlignTrailingComments:
  Kind: Leave
